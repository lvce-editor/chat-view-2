# Optional: used only by explicit evaluation:record / e2e:record commands.
# Use an LVCE backend access token. Normal replay never contacts the provider.
LVCE_ACCESS_TOKEN=

# Your LVCE backend Responses API root (not the OpenAI API).
EVALUATION_UPSTREAM_URL=http://127.0.0.1:3000/api/v1
EVALUATION_PORT=8787
# Optional when manually replaying from a non-local editor origin.
EVALUATION_ALLOWED_ORIGIN=
