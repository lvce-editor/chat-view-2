{
  "name": "builtin.chat-view-2",
  "version": "0.0.0-dev",
  "description": "A focused, low-overhead coding agent for Lvce Editor",
  "main": "dist/chatMain.js",
  "scripts": {
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch"
  },
  "author": "Lvce Editor",
  "license": "MIT",
  "type": "module",
  "jest": {
    "injectGlobals": false,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "dependencies": {
    "@babel/standalone": "7.29.9",
    "@lvce-editor/chat-tool-worker": "0.0.0-dev"
  },
  "devDependencies": {
    "@lvce-editor/api": "9.33.1",
    "@lvce-editor/rpc": "6.21.0",
    "@lvce-editor/rpc-registry": "9.65.1",
    "@lvce-editor/virtual-dom-worker": "11.20.1",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12"
  }
}
