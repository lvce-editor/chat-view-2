{
  "name": "builtin.chat-view-2-monorepo",
  "version": "0.0.0-dev",
  "description": "Chat 2 extension monorepo for Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:extension": "node packages/build/src/build-extension.ts",
    "build:static": "node scripts/build-static.ts",
    "build:watch": "./node_modules/.bin/esbuild --format=esm --bundle --external:electron --external:node:* --watch packages/extension/src/chatMain.ts --outfile=packages/extension/dist/chatMain.js",
    "check:budgets": "node scripts/check-budgets.ts",
    "dev": "node packages/build/src/dev.ts",
    "e2e": "cd packages/e2e && npm run e2e",
    "e2e:headless": "cd packages/e2e && npm run e2e:headless",
    "evaluation": "npm --prefix packages/evaluation run evaluation",
    "evaluation:prepare": "npm --prefix packages/evaluation run prepare-scenario --",
    "evaluation:proxy": "npm --prefix packages/evaluation run proxy --",
    "format": "prettier --write .",
    "install:extension": "node packages/build/src/install-extension.ts",
    "lint": "eslint . && prettier --check .",
    "test": "npm test --workspaces --if-present && node scripts/validate-evaluation.ts",
    "test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "type-check": "tsc -b"
  },
  "author": "Lvce Editor",
  "license": "MIT",
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.5.0",
    "eslint": "^10.8.0",
    "prettier": "^4.0.0-alpha.10",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
